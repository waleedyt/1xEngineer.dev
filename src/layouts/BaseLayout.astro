---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: string;
  date?: Date;
  isHome?: boolean;
}

const DEFAULT_TITLE = '1xEngineer';
const DEFAULT_DESCRIPTION =
  'I build distributed systems and lead engineering teams. These days, I’m exploring what happens when human craftsmanship and AI agents work together.';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  ogImage,
  type = 'website',
  date,
  isHome = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const resolvedImage =
  ogImage ?? new URL('/images/doors-choices.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title="1xEngineer" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- No-flash: set dark class before any paint -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)'
          ).matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="1xEngineer.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@_waleed_yt" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />

    {
      date && (
        <meta
          property="article:published_time"
          content={date.toISOString()}
        />
      )
    }

    <Analytics />
  </head>
  <body>
    <div class="page">
      <header>
        <div class="container header-inner">
          <Navigation isHome={isHome} />
        </div>
      </header>
      <main class="flex-grow">
        <div class="container">
          <slot />
        </div>
      </main>
      <footer>
        <div class="container footer-inner">
          <p class="footer-prompt">
            Open to thoughtful conversations, feedback, and interesting engineering problems.
          </p>
          <div class="footer-links">
            <a href="mailto:ch.aw.yt@gmail.com" class="footer-link">Get in touch</a>
            <a href="https://github.com/waleedyt" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
            <a href="https://www.linkedin.com/in/ahmedyt/" target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn</a>
            <a href="https://twitter.com/_waleed_yt" target="_blank" rel="noopener noreferrer" class="footer-link">X (Twitter)</a>
            <a href="/rss.xml" class="footer-link">RSS</a>
          </div>
        </div>
      </footer>
    </div>

    <style>
      .page {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      .flex-grow {
        flex: 1 0 auto;
      }
      .container {
        max-width: 64rem;
        margin-inline: auto;
        padding-inline: 2rem;
      }
      .header-inner {
        padding-block: 2rem;
      }
      .footer-inner {
        padding-block: 3rem 2rem;
        color: var(--color-muted);
        font-size: 0.9rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .footer-prompt {
        margin: 0;
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem;
      }
      .footer-links a,
      .footer-link {
        color: var(--color-link);
        text-decoration: none !important;
      }
      .footer-links a:hover,
      .footer-link:hover {
        color: var(--color-link-hover);
        text-decoration: none !important;
      }
    </style>
  </body>
</html>
